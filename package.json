{
  "name": "voluntary-manager",
  "version": "1.0.0",
  "main": "dist/bundle.js",
  "repository": "https://github.com/jiwjiwjiw/voluntary-manager.git",
  "author": "Jean Iwanowski <jean.iwanowski@edelweissloisirs.ch>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/init-workspace.js",
    "build": "webpack --mode none",
    "build:watch": "webpack --mode none -w",
    "push": "clasp push",
    "push:watch": "clasp push -w",
    "b": "yarn build",
    "bw": "yarn build:watch",
    "p": "yarn push",
    "pw": "yarn push:watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.13",
    "@types/node": "^24",
    "copy-webpack-plugin": "^14.0.0",
    "gas-webpack-plugin": "^2.6.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "yarn@1.22.22"
}
