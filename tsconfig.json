{
  "compilerOptions": {
    /* Apps Script runs on a recent V8: ES2020 syntax (optional chaining,
       nullish coalescing, etc.) is supported natively, so there is no need
       to downlevel to ES6. The es2021 lib adds String.prototype.replaceAll,
       which V8 in Apps Script also provides. */
    "target": "ES2020",
    "lib": ["es2021"],

    /* webpack bundles everything into a single file, so modules are
       resolved bundler-style and emitted as ESNext for ts-loader. */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,

    /* TypeScript 6 does not include @types/* automatically. */
    "types": ["google-apps-script", "node"],

    "rootDir": "./src",
    "outDir": "./dist",
    "removeComments": true,
    "noEmitOnError": true,

    /* Strictness */
    "strict": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"]
}
